# Copy this file to ".env" and fill in your key. NEVER commit the real .env file.

# Required for AI-powered analysis. Without a real key the app runs in built-in guidance mode.
GROQ_API_KEY=your_groq_api_key

# Optional settings (defaults shown). llama-3.3-70b-versatile is not on Groq's free tier.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=25
GROQ_MAX_RETRIES=1

# Set to true to skip the API entirely and always use built-in guidance (offline demo).
FORCE_OFFLINE_MODE=false
